{
  "name": "sonora-player",
  "productName": "Sonora",
  "version": "1.0.0",
  "description": "Player de Spotify para Windows 11 com Fluent Design (Electron castLabs + React + Vite)",
  "main": "./out/main/index.js",
  "author": "Sonora",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "setup": "node scripts/setup.cjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "vmp:sign-dev": "node scripts/vmp.cjs sign-pkg node_modules/electron/dist",
    "vmp:verify-dev": "node scripts/vmp.cjs verify-pkg node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.346",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "git+https://github.com/castlabs/electron-releases.git#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
